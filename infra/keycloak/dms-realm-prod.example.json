{
  "realm": "dms",
  "displayName": "DMS Realm",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "dms_admin", "description": "Full administrative access to the DMS" },
      { "name": "dms_department_manager", "description": "Manage documents within own department" },
      { "name": "dms_contributor", "description": "Upload and edit documents within own department" },
      { "name": "dms_viewer", "description": "Read-only access to permitted documents" }
    ]
  },
  "clients": [
    {
      "clientId": "dms-frontend",
      "name": "DMS Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": ["${DMS_FRONTEND_URL}/*"],
      "webOrigins": ["${DMS_FRONTEND_URL}"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dms-admin-api",
      "name": "DMS Backend Keycloak Directory Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${DMS_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "service-account-dms-admin-api",
      "enabled": true,
      "serviceAccountClientId": "dms-admin-api",
      "clientRoles": {
        "realm-management": ["query-users", "view-users", "view-realm"]
      }
    }
  ]
}
