{
  "realm": "dms",
  "displayName": "DMS Realm",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "dms_admin", "description": "Full administrative access to the DMS" },
      { "name": "dms_department_manager", "description": "Manage documents within own department" },
      { "name": "dms_contributor", "description": "Upload and edit documents within own department" },
      { "name": "dms_viewer", "description": "Read-only access to permitted documents" }
    ]
  },
  "clients": [
    {
      "clientId": "dms-frontend",
      "name": "DMS Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:80/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:80"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dms-admin-api",
      "name": "DMS Backend Keycloak Directory Client",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "${DMS_KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@dms.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "changeme_dev", "temporary": false }
      ],
      "realmRoles": ["dms_admin"]
    },
    {
      "username": "manager",
      "email": "manager@dms.local",
      "firstName": "Department",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "department": ["ITDLZ"]
      },
      "credentials": [
        { "type": "password", "value": "changeme_dev", "temporary": false }
      ],
      "realmRoles": ["dms_department_manager"]
    },
    {
      "username": "contributor",
      "email": "contributor@dms.local",
      "firstName": "Document",
      "lastName": "Contributor",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "department": ["ITDLZ"]
      },
      "credentials": [
        { "type": "password", "value": "changeme_dev", "temporary": false }
      ],
      "realmRoles": ["dms_contributor"]
    },
    {
      "username": "viewer",
      "email": "viewer@dms.local",
      "firstName": "Document",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "department": ["ITDLZ"]
      },
      "credentials": [
        { "type": "password", "value": "changeme_dev", "temporary": false }
      ],
      "realmRoles": ["dms_viewer"]
    },
    {
      "username": "service-account-dms-admin-api",
      "enabled": true,
      "serviceAccountClientId": "dms-admin-api",
      "clientRoles": {
        "realm-management": ["query-users", "view-users", "view-realm"]
      }
    }
  ]
}
