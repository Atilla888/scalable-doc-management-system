# Production example: inject these values from the deployment secret store.
# Empty required values make the backend/Keycloak configuration fail fast.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=
MONGODB_URI=
DMS_KEYCLOAK_ADMIN_BASE_URL=
DMS_KEYCLOAK_ADMIN_REALM=dms
DMS_KEYCLOAK_ADMIN_CLIENT_ID=dms-admin-api
DMS_KEYCLOAK_ADMIN_CLIENT_SECRET=
DMS_FRONTEND_URL=

# Public frontend build configuration.
VITE_API_BASE_URL=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=dms
VITE_KEYCLOAK_CLIENT_ID=dms-frontend
VITE_SHOW_DEMO_USERS=false

# Exact deployed frontend origins only; do not use '*'.
DMS_CORS_ALLOWED_ORIGINS=
DMS_MAX_FILE_SIZE=25MB
DMS_MAX_REQUEST_SIZE=26MB
DMS_ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
