# Copy this to .env before starting the stack:
#   cp .env.example .env

# Keycloak admin console login
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MongoDB. Root is for admin tasks only; the app connects as the limited
# app user (readWrite on the dms database). Use strong values outside dev.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=dms_app
MONGO_APP_PASSWORD=change-me-app
