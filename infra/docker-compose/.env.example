# REQUIRED for the Docker Compose stack. Copy this file to .env and fill in the
# secret values below, then run `docker compose up`. The stack has no weak fallback
# passwords: it refuses to start until every required secret is set. .env is
# gitignored and never committed.
#
#   cp .env.example .env      # then edit the blank values below
#
# Generate strong local values, for example:  openssl rand -hex 24

# --- Non-secret defaults (fine to leave as-is) ---
KEYCLOAK_ADMIN_USER=local-admin
MONGO_ROOT_USER=root
MONGO_APP_USER=dms_app

# --- REQUIRED secrets (must be non-empty, or the stack won't start) ---
# Keycloak admin console login
KEYCLOAK_ADMIN_PASSWORD=
# MongoDB: root is for admin/init only; the app connects as the limited app user.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
# Backend <-> Keycloak admin API client secret (must match the value the realm imports).
DMS_KEYCLOAK_ADMIN_CLIENT_SECRET=
# Password set on the imported demo users (this is how you log in to test locally).
DMS_DEMO_USER_PASSWORD=

# --- Optional tuning (defaults applied if omitted) ---
DMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
DMS_MAX_FILE_SIZE=50MB
DMS_MAX_REQUEST_SIZE=55MB
DMS_ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/xml,application/json,application/vnd.openxmlformats-officedocument.wordprocessingml.document
