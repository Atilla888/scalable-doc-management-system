# OPTIONAL. The stack runs out of the box: docker-compose.yml already ships
# working development defaults for every variable, so `docker compose up` works
# on a fresh clone with no setup.
#
# Create a .env (copy this file) ONLY if you want to override those defaults —
# e.g. stronger local passwords. .env is gitignored and never committed.
#   cp .env.example .env

# Keycloak admin console login
KEYCLOAK_ADMIN_USER=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password

# MongoDB. Root is for admin tasks only; the app connects as the limited
# app user (readWrite on the dms database). Use strong values outside dev.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-root
MONGO_APP_USER=dms_app
MONGO_APP_PASSWORD=change-me-app

# DMS development realm and backend directory client
DMS_KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-a-local-admin-api-secret
DMS_DEMO_USER_PASSWORD=changeme_dev

DMS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80
DMS_MAX_FILE_SIZE=50MB
DMS_MAX_REQUEST_SIZE=55MB
DMS_ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document
